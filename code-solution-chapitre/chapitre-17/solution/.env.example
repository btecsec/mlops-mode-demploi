# Copier en `.env` (gitignoré) pour le développement local.
# En production, ces valeurs viennent du Secret Kubernetes du Chapitre 12,
# jamais d'un fichier posé à côté du code.
#
#   kubectl create secret generic churn-api-secret \
#     --from-literal=PSEUDONYM_SALT="$(openssl rand -hex 32)"
#
# Le sel n'a pas de valeur par défaut dans privacy.py : un démarrage qui
# échoue bruyamment vaut mieux qu'un sel partagé par toutes les installations,
# qui rendrait les empreintes comparables entre elles.
PSEUDONYM_SALT=changez-moi-avec-openssl-rand-hex-32

# Chapitre 17 : clé OpenRouter pour explain.py et judge.py. Elle n'a pas non
# plus de valeur par défaut — get_llm() la lit dans l'environnement et échoue
# sur KeyError si elle manque, plutôt que d'émettre une requête anonyme.
OPENROUTER_API_KEY=sk-or-v1-changez-moi
