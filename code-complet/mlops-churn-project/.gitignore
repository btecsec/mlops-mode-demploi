# Environnements
venv/
.venv/
.venv-airflow/
__pycache__/
*.pyc
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# Données volumineuses (versionnées via DVC au chapitre 5, pas via Git)
#data/raw/*.csv

# Modèles entraînés (versionnés via MLflow au chapitre 4)
models/*.pkl

# Secrets et config locale
.env

# OS
.DS_Store
Thumbs.db

# Historique local MLflow
mlruns/

# Base SQLite de tracking MLflow (chapitre 7)
mlflow.db

# Logs de build
build.log

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
# Plan enregistré : instantané binaire complet, valeurs de variables
# comprises. Se relit avec `terraform show tfplan`, ne se commite jamais.
tfplan
*.tfplan
# Le lock du provider n'est pas suivi ici : les corriges du livre doivent
# pouvoir s'initialiser sur n'importe quelle plateforme, et un lock fige les
# empreintes d'une seule.
.terraform.lock.hcl

# Reconversion pandoc du docx, produite pour reperer une edition Word non
# reportee. Jetable, regeneree a chaque comparaison.
tmp-diff.md

# Réponse de l'endpoint SageMaker (Chapitre 14) : invoke-endpoint écrit son
# résultat dans un fichier, jamais sur la sortie standard. Sortie, pas source.
output.json

# Journal des prédictions (Ch. 15) : des données client, jamais versionnées.
logs/

# Sauvegardes horodatees posees par les scripts de correction.
*.bak-*
